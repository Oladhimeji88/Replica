# Copy to .env and fill in. Every value below is optional except the Anthropic
# key — the app validates this file at boot and tells you exactly what is wrong.

# ============================================================================
# Required
# ============================================================================

# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here


# ============================================================================
# Runtime
# ============================================================================

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Set to true when running behind a proxy (Render, Railway, Fly, nginx) so the
# rate limiter sees real client IPs instead of bucketing everyone together.
TRUST_PROXY=false

# Comma-separated allowlist for browsers on other origins. Leave blank when the
# page and API share an origin, which is the normal setup.
CORS_ORIGINS=

# Requests per window, per IP, across /api. Chat requests cost real money, so
# this protects the bill as much as the server.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30


# ============================================================================
# Language model
# ============================================================================

CLAUDE_MODEL=claude-opus-5

# Replies are spoken aloud, so they should be short. Raise if you want longer
# answers; every token here is billed.
CLAUDE_MAX_TOKENS=2048

# How hard the model thinks before answering: low | medium | high | xhigh | max.
# `low` keeps voice replies fast. Raise it if answers feel shallow.
CLAUDE_EFFORT=low

CLAUDE_TIMEOUT_MS=60000


# ============================================================================
# Text to speech  (TTS_PROVIDER: elevenlabs | edge | none)
# ============================================================================
#
#   edge        free, no account, generic voice — the default
#   elevenlabs  paid, sounds like you if you clone your voice
#   none        the browser speaks the reply with its own built-in voice
#
TTS_PROVIDER=edge

# Any Microsoft Edge voice name, used when TTS_PROVIDER=edge.
EDGE_TTS_VOICE=en-US-GuyNeural

# Used when TTS_PROVIDER=elevenlabs. Clone your voice at elevenlabs.io, then
# copy its ID from the voice library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5


# ============================================================================
# Speech to text  (STT_PROVIDER: deepgram | openai | none)
# ============================================================================
#
#   none      the browser transcribes the mic itself. Free, but Chrome/Edge only.
#   deepgram  fast and cheap, works in every browser
#   openai    Whisper, very accurate, slightly slower
#
STT_PROVIDER=none

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

STT_MAX_UPLOAD_MB=20


# ============================================================================
# Talking face  (AVATAR_PROVIDER: colab | none)
# ============================================================================
#
# `colab` drives the SadTalker notebook in colab/. Paste the ngrok URL the
# notebook prints. See the README for the full walkthrough.
#
AVATAR_PROVIDER=none
COLAB_API_URL=
AVATAR_TIMEOUT_MS=300000

# Generated clips are video of your face — they are deleted after this long.
# Set to 0 to keep them forever (not recommended).
MEDIA_RETENTION_MS=3600000


# ============================================================================
# Persona
# ============================================================================

PERSONA_DIR=persona

# Reload persona files when they change, without restarting. Handy while you
# are writing them; harmless in production.
PERSONA_WATCH=true
