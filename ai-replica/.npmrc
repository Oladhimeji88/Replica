# Dependency install scripts are disabled project-wide.
#
# Two reasons. First, supply-chain hygiene: an `install` or `postinstall` hook
# is arbitrary code from a transitive dependency, and nothing in this tree needs
# one (esbuild ships its binary as an optional platform package and works
# without its hook).
#
# Second, concretely: msedge-tts v2 declares `preinstall: npx only-allow pnpm`,
# which aborts any npm install outright. v2 is the version that still works
# against Microsoft's endpoint — v1 fails to connect — so this project needs v2
# and npm both.
ignore-scripts=true
